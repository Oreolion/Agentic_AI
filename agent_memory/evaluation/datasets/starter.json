      "expected": {"chunks": [
        {"source_id": "fixture-paper", "version": "v2", "chunk_id": "0", "content_sha256": "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc"},
        {"source_id": "fixture-paper", "version": "v2", "chunk_id": "1", "content_sha256": "dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd"}
      ]}
    },
    {
      "case_id": "retrieval-evidence", "component_ids": ["C08"], "kind": "retrieval",
