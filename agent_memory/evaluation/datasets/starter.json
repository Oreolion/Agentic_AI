      "expected": {"allowed_tools": ["arxiv_search_candidates", "fetch_and_save_paper_to_kb_db", "expand_summary"], "required_tools": ["arxiv_search_candidates", "fetch_and_save_paper_to_kb_db"], "max_calls": 3}
    },
    {
      "case_id": "policy-success", "component_ids": ["C20"], "kind": "controller",
      "description": "Routine success never needs a separate reflection call.",
      "expected": {"action": "continue"}
    },
    {
      "case_id": "policy-permanent", "component_ids": ["C11", "C20"], "kind": "controller",
      "description": "A known permanent error changes strategy or reports a blocker without reflection.",
      "expected": {"action": "change_strategy_or_report"}
    },
    {
      "case_id": "policy-retry-cap", "component_ids": ["C01", "C11", "C20"], "kind": "controller",
      "description": "SDK and application attempts share a total cap.",
      "expected": {"action": "report_blocker"}
    },
    {
      "case_id": "policy-scope", "component_ids": ["C11", "C20"], "kind": "controller",
